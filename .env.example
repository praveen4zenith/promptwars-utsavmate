# UtsavMate AI Environment Variables
# NEVER prefix these with NEXT_PUBLIC_ to ensure they stay strictly on the server!

# Google Gemini API Key (Get yours free from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
